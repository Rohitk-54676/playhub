generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @db.Uuid
  username    String   @unique
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  accent      String   @default("purple")
  isGuest     Boolean  @default(false) @map("is_guest")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sentRequests        Friendship[]        @relation("RequesterFriendships")
  receivedRequests    Friendship[]        @relation("AddresseeFriendships")
  blocksInitiated     Block[]             @relation("BlockerBlocks")
  blocksReceived      Block[]             @relation("BlockedBlocks")
  notifications       Notification[]      @relation("UserNotifications")
  notificationsSent   Notification[]      @relation("ActorNotifications")
  conversationMembers ConversationMember[]
  messagesSent        Message[]
  roomsHosted         Room[]              @relation("RoomHost")
  roomPlayers         RoomPlayer[]
  bingoCards          BingoCard[]
  bingoPicks          BingoPick[]

  @@map("profiles")
}

model Friendship {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @map("requester_id") @db.Uuid
  addresseeId String   @map("addressee_id") @db.Uuid
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requester Profile @relation("RequesterFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Profile @relation("AddresseeFriendships", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker Profile @relation("BlockerBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("BlockedBlocks", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user  Profile  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor Profile? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@map("notifications")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @default("direct")
  name      String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  ConversationMember[]
  messages Message[]

  @@index([updatedAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at")
  lastReadAt     DateTime @default(now()) @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  gameId    String   @map("game_id")
  hostId    String   @map("host_id") @db.Uuid
  status    String   @default("lobby")
  state     Json?
  isSolo    Boolean  @default(false) @map("is_solo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  host    Profile      @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  players RoomPlayer[]

  @@index([code])
  @@index([updatedAt])
  @@map("rooms")
}

model RoomPlayer {
  roomId   String   @map("room_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  isHost   Boolean  @default(false) @map("is_host")
  isBot    Boolean  @default(false) @map("is_bot")
  joinedAt DateTime @default(now()) @map("joined_at")

  room Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("room_players")
}

model BingoCard {
  id                String    @id @default(uuid()) @db.Uuid
  roomId            String    @map("room_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  numbers           Int[]
  marked            Int[]     @default([])
  lines             Int       @default(0)
  bingoLockoutUntil DateTime? @map("bingo_lockout_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("bingo_cards")
}

model BingoPick {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  number    Int
  createdAt DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("bingo_picks")
}

model DotsGame {
  id            String   @id @default(uuid()) @db.Uuid
  roomId        String   @unique @map("room_id") @db.Uuid
  size          Int      @default(5)
  horizontal    Json     @default("[]")
  vertical      Json     @default("[]")
  lineOwners    Json     @default("{}") // { "h:5": userId, "v:12": userId }
  boxes         Json     @default("{}")
  playerColors  Json     @default("{}")
  playerLetters Json     @default("{}")
  turnOrder     Json     @default("[]")
  currentTurn   Int      @default(0)
  lastLineType  String?  @map("last_line_type")
  lastLineIdx   Int?     @map("last_line_idx")
  winnerId      String?  @map("winner_id") @db.Uuid
  turnStartedAt DateTime @default(now()) @map("turn_started_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("dots_games")
}